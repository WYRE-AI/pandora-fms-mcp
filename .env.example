# Base URL of the Pandora FMS / Pandora Open console (https only; no trailing path).
PANDORA_BASE_URL=https://pandora.example.com
# Per-user API token (Pandora console: user edit page -> API token). Never commit a real value.
PANDORA_API_TOKEN=
# Comma-separated tiers to expose: read, write, admin (default: read)
PANDORA_TOOL_TIERS=read
AUTH_MODE=env
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=127.0.0.1
# Required for HTTP: >= 32 chars (openssl rand -hex 32); placeholders are rejected
CONDUIT_S2S_SECRET=
# Extra allowed Host header values (no ports), comma separated; DNS-rebinding protection
# MCP_ALLOWED_HOSTS=mcp.example.com
MCP_ALLOW_INSECURE_DEV=0
# Optional PEM CA bundle for a console with a private CA
PANDORA_CA_CERT_FILE=
LOG_LEVEL=info
